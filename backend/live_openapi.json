{"openapi":"3.1.0","info":{"title":"Backend API","description":"FastAPI backend serving the multilingual agriculture datasets","version":"0.1.0"},"paths":{"/chat":{"post":{"tags":["chat"],"summary":"Chat","description":"Answer a farmer's question through the Stage-2 RAG pipeline.\n\nCache-first: identical/near-identical questions inside 24 hours return\nthe previous answer with no retrieval and no AI call. Otherwise the\nrule-based router picks the retrieval strategy, the 5-provider rotation\ngenerates the answer with the session's recent turns as context, and the\nresult is verified against the retrieved chunks (internal flag only).","operationId":"chat_chat_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChatRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChatResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/chat/voice":{"post":{"tags":["chat"],"summary":"Chat Voice","description":"Transcribe a farmer's spoken question with Gemini, then answer it.\n\nVoice turns are soft-limited per session_id: a clip longer than 60 seconds\nis rejected, and a session that has used 5 minutes of total voice time\ngets HTTP 429 with a retry_after_seconds hint (usage resets after a\n15-minute cooldown). Both checks run before Gemini is called, so rejected\nturns cost no transcription API calls. The raw audio goes to Gemini's\nmultimodal model for transcription; the transcript then goes through the\nsame response cache + routed RAG retrieval + provider rotation as /chat.","operationId":"chat_voice_chat_voice_post","parameters":[{"name":"session_id","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Same value as the session_id form field","title":"Session Id"},"description":"Same value as the session_id form field"}],"requestBody":{"required":true,"content":{"multipart/form-data":{"schema":{"$ref":"#/components/schemas/Body_chat_voice_chat_voice_post"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/VoiceChatResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/schemes":{"get":{"tags":["info"],"summary":"List Schemes","description":"Summaries of the main schemes, with coverage read from the knowledge base.","operationId":"list_schemes_schemes_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/prices":{"get":{"tags":["info"],"summary":"List Prices","description":"Market-wise price and arrival records from the prices dataset.","operationId":"list_prices_prices_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/officer/login":{"post":{"tags":["officer"],"summary":"Officer Login","description":"Exchange officer credentials for an in-memory session token.","operationId":"officer_login_officer_login_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/OfficerLogin"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/OfficerLoginResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/presence/start":{"post":{"tags":["presence"],"summary":"Presence Start","description":"Start the webcam presence watcher as a background thread.\n\nSeeds the edge-triggered state machine and returns immediately. If a watcher\nis already running (from a previous /presence/start) this is a no-op and\nreturns its current status, so the call is safe to repeat at any time.","operationId":"presence_start_presence_start_post","parameters":[{"name":"camera_index","in":"query","required":false,"schema":{"type":"integer","default":0,"title":"Camera Index"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/presence/stop":{"post":{"tags":["presence"],"summary":"Presence Stop","description":"Stop the presence watcher cleanly.\n\nStops the background thread by releasing the camera and clearing the\nmodule-level reference. Idempotent: calling it when nothing is running is a\nno-op. Returns the last observed poll state.","operationId":"presence_stop_presence_stop_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/presence/status":{"get":{"tags":["presence"],"summary":"Presence Status","description":"Current state of the presence watchdog, or stopped.","operationId":"presence_status_presence_status_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/grievance":{"post":{"tags":["grievance"],"summary":"Create Grievance","description":"File a new grievance; only the problem statement is required.","operationId":"create_grievance_grievance_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/GrievanceCreate"}}},"required":true},"responses":{"201":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GrievanceCreated"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/grievance/officer/list":{"get":{"tags":["grievance"],"summary":"Officer List","description":"All grievances, newest first (officer dashboard; token required).","operationId":"officer_list_grievance_officer_list_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}},"security":[{"HTTPBearer":[]}]}},"/grievance/{grievance_id}":{"get":{"tags":["grievance"],"summary":"Get Grievance","description":"Current status and details for one grievance id.","operationId":"get_grievance_grievance__grievance_id__get","parameters":[{"name":"grievance_id","in":"path","required":true,"schema":{"type":"string","title":"Grievance Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GrievanceOut"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/grievance/{grievance_id}/status":{"patch":{"tags":["grievance"],"summary":"Update Status","description":"Officer updates the status to new/seen/in_progress/resolved (token required).","operationId":"update_status_grievance__grievance_id__status_patch","security":[{"HTTPBearer":[]}],"parameters":[{"name":"grievance_id","in":"path","required":true,"schema":{"type":"string","title":"Grievance Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/GrievanceStatusUpdate"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GrievanceOut"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/":{"get":{"summary":"Health Check","operationId":"health_check__get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}}},"components":{"schemas":{"Body_chat_voice_chat_voice_post":{"properties":{"file":{"type":"string","contentMediaType":"application/octet-stream","title":"File","description":"Recorded audio clip"},"session_id":{"anyOf":[{"type":"string