# Copy to .env and fill in real values.
GEMINI_API_KEY=your_key_here
GROQ_API_KEY=your_key_here
COHERE_API_KEY=your_key_here
OPENROUTER_API_KEY=your_key_here
HUGGINGFACE_API_KEY=your_key_here

# Officer dashboard login (single hardcoded account).
# Generate a strong password, e.g. python -c "import secrets;print(secrets.token_urlsafe(20))"
OFFICER_USERNAME=officer
OFFICER_PASSWORD=change_me_to_a_long_random_password

# ---- Kiosk hardware state machine (all OPTIONAL; safe defaults) -----------
# Backend the kiosk state machine talks to (same process by default).
HARDWARE_API_BASE=http://127.0.0.1:8000
# Base for per-session chat ids (context memory across turns).
HARDWARE_SESSION_ID=hardware-kiosk
# Webcam index for /presence/start started by the kiosk's CHECKING state.
HARDWARE_CAMERA_INDEX=0
# Max mic seconds per LISTENING turn before it counts as a no-response
# timeout (the farmer never spoke). 20 keeps silent turns snappy.
HARDWARE_LISTEN_SECONDS=20
# Ultrasonic sensor trigger (BCM pin on the Raspberry Pi). Unset = sensor
# disabled (laptop demo); the kiosk is driven by POST /hardware/trigger.
HARDWARE_TRIG_PIN=
# Optional raw HC-SR04 ECHO pin (two-pin wiring). Unset = edge-triggered
# single-OUT wiring.
HARDWARE_ECHO_PIN=
# Seconds to wait for the farmer to pick a language when speech is
# undetectable; Telugu is the default afterwards.
LANG_TIMEOUT_SECONDS=8
# Welcome repeat count and delay when nobody responds to the first welcome.
WELCOME_RETRIES=3
WELCOME_RETRY_DELAY_SECONDS=6
# Total kiosk session length; a turn already in progress gets
# GRACE_PERIOD_SECONDS extra seconds to finish.
SESSION_TIMEOUT_MINUTES=10
GRACE_PERIOD_SECONDS=120
# Session ends only after this many seconds of CONTINUOUS absence (no face,
# no speech, no answer in progress) — not on momentary sensor dropouts.
ABSENCE_GRACE_SECONDS=60
# Post-session cooldown; sensor fluctuations in this window are ignored.
COOLDOWN_SECONDS=10
# Interruption tuning: mic RMS that counts as the farmer talking over the
# TTS (needs to sit above speaker-to-mic echo so the kiosk cannot interrupt
# itself) and how many 100 ms loud blocks confirm it.
INTERRUPTION_RMS_THRESHOLD=0.04
INTERRUPTION_LOUD_BLOCKS=3